MODE=demo
# Set MODE=live only after database migration and ingestion.
BACKEND_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6-luna
# Keep none for low latency; use low only after evaluating quality and latency.
LLM_REASONING_EFFORT=none
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
SUPABASE_URL=
# Server-only sb_secret_ key; sent in apikey, never as a Bearer token.
SUPABASE_SECRET_KEY=
CORS_ORIGINS=["http://localhost:3000"]
TOP_K=5
SIMILARITY_THRESHOLD=0.35
# Secondary per-peer/process safety guard; Next.js + Redis enforce visitor quotas.
RATE_LIMIT_PER_MINUTE=60


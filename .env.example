# Frontend; public canonical origin, no trailing slash
SITE_URL=http://localhost:3000
# Local/independent hosting only: empty = preview; configured = live FastAPI proxy.
# Vercel Services injects TAI_BACKEND_URL at runtime. Do not set it manually.
BACKEND_URL=
BACKEND_API_KEY=
# Cloud Run only: 0 uses conservative shared Redis quotas. Set a verified hop
# count only after checking the deployed proxy chain; never trust the first XFF.
CLOUD_RUN_TRUSTED_PROXY_HOPS=0
# K_SERVICE is platform-injected; do not set it for local development.
# Locally, Supabase credentials belong in backend/.env. On Vercel, use server-only
# project environment variables (see VERCEL_DEPLOYMENT.md); never NEXT_PUBLIC_.
# Server-only contact delivery; verified Resend sender address required.
RESEND_API_KEY=
CONTACT_EMAIL_TO=tudor.iacob@gmail.com
CONTACT_EMAIL_FROM=
# Shared Redis: contact fails closed. T AI also fails closed on Cloud Run;
# other hosting retains its existing backend safety fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: only set behind a gateway that overwrites this single-IP header.
# Only needed outside Vercel. The gateway must overwrite this header; block direct access.
TRUSTED_CLIENT_IP_HEADER=


# Server-side T AI quotas per visitor IP. Invalid/missing values use these defaults.
TAI_RATE_LIMIT_PER_MINUTE=15
TAI_RATE_LIMIT_PER_DAY=100

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs",
      "installCommand": "pnpm install --frozen-lockfile",
      "buildCommand": "pnpm build",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "TAI_BACKEND_URL"
        }
      ]
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "app.main:app",
      "functions": {
        "app/main.py": {
          "maxDuration": 60,
          "excludeFiles": "{tests/**,ingestion/**,__pycache__/**,.pytest_cache/**,.venv/**,.env,.env.*}"
        }
      }
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "app" } }]
}
